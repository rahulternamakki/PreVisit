# Server Configuration
PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Groq API (Phase 2 & Phase 3)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Credentials (Phase 1)
# Note: Use the service role key on the backend to bypass RLS for internal operations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Doctor Portal Security (Phase 4)
DOCTOR_PASSCODE=123456
JWT_SECRET_KEY=generate_a_random_secret_key_here
